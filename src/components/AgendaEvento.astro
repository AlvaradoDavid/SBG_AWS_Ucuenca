---
/**
 * La agenda del día de un próximo evento (D-34): un bloque por horario y, cuando
 * hay sesiones a la vez, una columna por sala, siempre en el orden de `salas`.
 *
 * Todo es HTML estático y se lee completo sin JavaScript. Con él aparecen dos
 * atajos: ver solo una sala y copiar el enlace a #agenda. Sin JavaScript no se
 * muestran, en vez de quedar como botones que no hacen nada.
 *
 * Texto siempre en `tinta` (regla 1): el morado va en el ícono de la sala, el punto
 * de los talleres, los bordes y el filtro activo, que es blanco sobre morado-700.
 */
import { club } from '../lib/categorias';
import { diaDeEvento, fechaIsoDeEvento, horaDeAgenda, horaDeEvento } from '../lib/fechas';
import { bloquesDeAgenda, estaVigente, type Agenda, type Proximo, type Sesion } from '../lib/proximos';

interface Props {
  evento: Proximo;
}

const { evento } = Astro.props;
const { inicio, fin, lugar } = evento.data;
// La página solo monta este componente si el evento tiene agenda (tieneAgenda).
const agenda = evento.data.agenda as Agenda;
const bloques = bloquesDeAgenda(agenda);
// Para el `datetime` de cada hora. El rango se ve «10h00 – 11h00» y se escucha «10h00 a 11h00».
const fecha = fechaIsoDeEvento(inicio);
const vigente = estaVigente(evento);
const instagram = `@${new URL(club.instagram).pathname.replaceAll('/', '')}`;

const cuantas = (tipo: Sesion['tipo']) => agenda.sesiones.filter((s) => s.tipo === tipo).length;
const plural = (n: number, una: string, varias: string) => `${n} ${n === 1 ? una : varias}`;
const charlas = cuantas('charla');
const talleres = cuantas('taller');
const sesionesTecnicas = [
  charlas > 0 && plural(charlas, 'charla', 'charlas'),
  talleres > 0 && plural(talleres, 'taller', 'talleres'),
]
  .filter(Boolean)
  .join(' y ');
const dia = diaDeEvento(inicio);
const resumen =
  `${dia.charAt(0).toUpperCase()}${dia.slice(1)}, de ${horaDeEvento(inicio)} a ${horaDeEvento(fin)}, ` +
  `en el ${lugar[0]}: ${sesionesTecnicas} en ${plural(agenda.salas.length, 'sala', 'salas')}` +
  `${agenda.salas.length > 1 ? ' a la vez' : ''}.`;

// Las clases tienen que estar escritas enteras para que Tailwind las genere.
const columnas: Record<number, string> = {
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-3',
  4: 'md:grid-cols-2 xl:grid-cols-4',
};

const etiquetas: Record<Sesion['tipo'], string> = {
  charla: 'Charla',
  taller: 'Taller',
  general: 'Para todos',
  pausa: 'Pausa',
};

const tarjeta: Record<Sesion['tipo'], string> = {
  charla: 'border-morado-100 bg-white shadow-sm shadow-morado-900/5',
  taller: 'border-morado-200 bg-white shadow-sm shadow-morado-900/5',
  general: 'border-morado-100 bg-white',
  // Punteada, para que se lea como un respiro y no como otra sesión. tinta-600 encima: 8.8:1.
  pausa: 'border-dashed border-morado-300 bg-morado-50',
};

// Los {' '} de la línea final hacen falta: Astro se come el salto de línea antes de un enlace.
const enlaceClaro =
  'font-bold text-tinta-900 underline decoration-marca-purple decoration-2 underline-offset-4 transition hover:decoration-tinta-900';
---

<section id="agenda" data-agenda aria-labelledby="titulo-agenda" class="fondo-aurora border-y border-morado-100">
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div data-reveal class="max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-widest text-tinta-500">Agenda</p>
      <h2 id="titulo-agenda" class="mt-3 font-display text-3xl font-bold text-tinta-900">El programa del día</h2>
      <p class="mt-4 leading-relaxed text-tinta-600">{[resumen, agenda.nota].filter(Boolean).join(' ')}</p>
    </div>

    <!-- Los atajos solo existen con JavaScript: el script quita este `hidden`. -->
    <div data-herramientas hidden class="mt-8 flex flex-wrap items-end justify-between gap-4">
      <div role="group" aria-label="Ver las sesiones de una sala" class="flex flex-wrap items-center gap-2">
        <span class="mr-1 font-mono text-[11px] uppercase tracking-widest text-tinta-500">Sala</span>
        <button type="button" class="filtro-sala" data-filtro-sala="" aria-pressed="true">Todas</button>
        {agenda.salas.map((sala) => (
          <button type="button" class="filtro-sala" data-filtro-sala={sala} aria-pressed="false">{sala}</button>
        ))}
      </div>
      <button
        type="button"
        data-copiar
        hidden
        class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-tinta-300 bg-white px-4 text-sm font-bold text-tinta-900 transition hover:border-morado-300 hover:bg-morado-50"
      >
        <svg aria-hidden="true" class="h-4 w-4 shrink-0 text-marca-purple" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
        </svg>
        <span data-copiar-texto>Copiar enlace a la agenda</span>
      </button>
    </div>
    <p data-estado aria-live="polite" class="sr-only"></p>

    <ol class="mt-10 space-y-8 lg:space-y-5">
      {bloques.map((bloque) => {
        const aLaVez = bloque.sesiones.length;
        return (
          <li data-bloque data-reveal class="grid gap-x-8 gap-y-3 lg:grid-cols-[9rem_minmax(0,1fr)]">
            <div class="lg:pt-5">
              <h3 class="font-display text-lg font-bold tabular-nums text-tinta-900">
                <time datetime={`${fecha}T${bloque.desde}`}>{horaDeAgenda(bloque.desde)}</time>{' '}
                <span aria-hidden="true">–</span><span class="sr-only">a</span>{' '}
                <time datetime={`${fecha}T${bloque.hasta}`}>{horaDeAgenda(bloque.hasta)}</time>
              </h3>
              {aLaVez > 1 && <p class="mt-1 text-sm text-tinta-500">{aLaVez} sesiones a la vez</p>}
            </div>

            <ul data-rejilla class:list={['grid gap-4', aLaVez > 1 && columnas[Math.min(aLaVez, 4)]]}>
              {bloque.sesiones.map((sesion) => {
                const deUnaSala = sesion.tipo === 'charla' || sesion.tipo === 'taller';
                return (
                  <li
                    data-sesion
                    data-sala={deUnaSala ? sesion.sala : undefined}
                    class:list={['flex flex-col rounded-xl border p-5', tarjeta[sesion.tipo]]}
                  >
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                      {sesion.sala && (
                        <p class="inline-flex items-center gap-1.5 text-sm font-bold text-tinta-700">
                          <svg aria-hidden="true" class="h-4 w-4 shrink-0 text-marca-purple" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                          </svg>
                          <span class="sr-only">Sala:</span>
                          {sesion.sala}
                        </p>
                      )}
                      <span
                        class:list={[
                          'inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-bold',
                          // Con sala, la etiqueta va a la derecha; sin ella, encabeza la tarjeta.
                          sesion.sala && 'ml-auto',
                          sesion.tipo === 'taller'
                            ? 'bg-morado-100 text-tinta-800 ring-1 ring-morado-200'
                            : 'bg-tinta-100 text-tinta-700',
                        ]}
                      >
                        {sesion.tipo === 'taller' && <span aria-hidden="true" class="h-1.5 w-1.5 bg-marca-purple"></span>}
                        {etiquetas[sesion.tipo]}
                      </span>
                    </div>

                    <h4 class="mt-3 font-display text-lg font-bold leading-snug text-tinta-900">{sesion.titulo}</h4>

                    {sesion.ponente && (
                      <p class="mt-3 text-sm leading-snug text-tinta-600">
                        <span class="block font-bold text-tinta-900">{sesion.ponente}</span>
                        {sesion.afiliacion && (
                          <span class="mt-0.5 block">
                            {sesion.afiliacion}{sesion.patrocinador && ', patrocinador del evento'}
                          </span>
                        )}
                      </p>
                    )}

                    {sesion.nota && <p class="mt-2 text-sm leading-relaxed text-tinta-600">{sesion.nota}</p>}
                  </li>
                );
              })}
            </ul>
          </li>
        );
      })}
    </ol>

    {vigente && (
      <p data-reveal class="mt-10 max-w-3xl text-sm leading-relaxed text-tinta-600">
        Si algo cambia, lo avisamos en Instagram,{' '}
        <a href={club.instagram} target="_blank" rel="noopener noreferrer" class={enlaceClaro}>{instagram}</a>.
        Y si tienes dudas, escríbenos por ahí o por{' '}
        <a href={club.linkedin} target="_blank" rel="noopener noreferrer" class={enlaceClaro}>LinkedIn</a>.
      </p>
    )}
  </div>
</section>

<style>
  /* Como los filtros del catálogo: 44 px de alto, y el activo en blanco sobre morado-700 (7.6:1). */
  .filtro-sala {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    border-radius: 9999px;
    border: 1px solid var(--color-tinta-200);
    background-color: white;
    padding: 0.375rem 1rem;
    font-size: 0.875rem;
    color: var(--color-tinta-600);
    cursor: pointer;
    transition:
      background-color 150ms,
      border-color 150ms,
      color 150ms;
  }
  .filtro-sala:hover {
    border-color: var(--color-morado-300);
  }
  .filtro-sala[aria-pressed='true'] {
    border-color: var(--color-morado-700);
    background-color: var(--color-morado-700);
    color: white;
    font-weight: 700;
  }
  /* Con una sola sala a la vista, su sesión ocupa el ancho del bloque, como las generales. */
  .agenda-filtrada [data-rejilla] {
    grid-template-columns: minmax(0, 1fr);
  }
</style>

<script>
  const agenda = document.querySelector<HTMLElement>('[data-agenda]');
  const herramientas = agenda?.querySelector<HTMLElement>('[data-herramientas]');
  const estado = agenda?.querySelector<HTMLElement>('[data-estado]');

  if (agenda && herramientas && estado) {
    herramientas.hidden = false;

    // Ver una sala: sus charlas y talleres, y además lo que es para todos.
    const filtros = [...agenda.querySelectorAll<HTMLButtonElement>('[data-filtro-sala]')];
    for (const boton of filtros) {
      boton.addEventListener('click', () => {
        const sala = boton.dataset.filtroSala ?? '';
        for (const otro of filtros) otro.setAttribute('aria-pressed', String(otro === boton));
        agenda.classList.toggle('agenda-filtrada', sala !== '');
        for (const bloque of agenda.querySelectorAll<HTMLElement>('[data-bloque]')) {
          let visibles = 0;
          for (const sesion of bloque.querySelectorAll<HTMLElement>('[data-sesion]')) {
            const seVe = !sala || !sesion.dataset.sala || sesion.dataset.sala === sala;
            sesion.hidden = !seVe;
            if (seVe) visibles++;
          }
          bloque.hidden = visibles === 0;
        }
        estado.textContent = sala ? `Agenda de ${sala}, más lo que es para todos` : 'Agenda completa';
      });
    }

    // Copiar el enlace: solo si el navegador deja escribir en el portapapeles.
    const copiar = agenda.querySelector<HTMLButtonElement>('[data-copiar]');
    const texto = copiar?.querySelector<HTMLElement>('[data-copiar-texto]');
    if (copiar && texto && navigator.clipboard) {
      copiar.hidden = false;
      const original = texto.textContent;
      copiar.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(`${location.origin}${location.pathname}#agenda`);
          texto.textContent = 'Enlace copiado';
          estado.textContent = 'Enlace a la agenda copiado';
          setTimeout(() => (texto.textContent = original), 2500);
        } catch {
          estado.textContent = 'No se pudo copiar el enlace';
        }
      });
    }
  }
</script>
