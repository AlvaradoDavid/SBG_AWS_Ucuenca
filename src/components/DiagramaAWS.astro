---
/**
 * Diagrama de arquitectura declarativo: recibe nodos y flujos, calcula el
 * layout y emite SVG en tiempo de build. Cero JavaScript en el cliente.
 *
 * Los colores salen de la categoría de cada servicio, así que los diagramas
 * comparten el mismo código de color que las tarjetas y los puntos del catálogo.
 *
 * El texto del SVG es texto real —seleccionable y nítido a cualquier escala—
 * pero OJO: Pagefind no indexa el contenido de los <text> de un SVG. Lo que sí
 * indexa es el <figcaption>, así que la prop `descripcion` debe nombrar todos
 * los servicios que aparecen en el dibujo. Comprobado sobre el índice generado.
 */
import { colorDeCategoria } from '../lib/categorias';

export interface NodoDiagrama {
  id: string;
  etiqueta: string;
  /** Segunda línea, para matizar: "bucket de origen", "tabla de sesiones". */
  sub?: string;
  /** Slug de categoría; define el color. Se ignora si tipo es 'externo'. */
  categoria?: string;
  /** 'externo' dibuja el actor (usuario, navegador) con borde punteado. */
  tipo?: 'servicio' | 'externo';
  /** Fila dentro de su columna, para ordenar ramas. Por defecto, 0. */
  fila?: number;
}

export interface FlujoDiagrama {
  de: string;
  a: string;
  etiqueta?: string;
}

interface Props {
  /** Nombre corto del diagrama. Es el nombre accesible de la imagen. */
  titulo: string;
  /** Narración del flujo en prosa. Se muestra como pie y sirve de alternativa
      textual: un diagrama es una imagen vacía para un lector de pantalla. */
  descripcion: string;
  nodos: NodoDiagrama[];
  flujos: FlujoDiagrama[];
}

const { titulo, descripcion, nodos, flujos } = Astro.props;

// --- Geometría -------------------------------------------------------------
const NODO_W = 132;
const NODO_H = 78;
const SEP_H = 88;
const SEP_V = 26;
const MARGEN = 14;
/** Espacio reservado arriba para las etiquetas de los flujos. */
const ALTO_ETIQUETA = 20;

/**
 * Columna de cada nodo: la longitud del camino más largo desde un origen.
 * Con grafos acíclicos basta iterar tantas veces como nodos haya.
 */
function calcularColumnas(): Map<string, number> {
  const columna = new Map(nodos.map((n) => [n.id, 0]));
  for (let vuelta = 0; vuelta < nodos.length; vuelta++) {
    let cambio = false;
    for (const flujo of flujos) {
      const origen = columna.get(flujo.de);
      const destino = columna.get(flujo.a);
      if (origen === undefined || destino === undefined) continue;
      if (destino < origen + 1) {
        columna.set(flujo.a, origen + 1);
        cambio = true;
      }
    }
    if (!cambio) break;
  }
  return columna;
}

/**
 * Aviso en tiempo de build si una etiqueta de flujo no cabe en el hueco entre
 * columnas. Más ancha que el hueco, la etiqueta acaba pisando las cajas vecinas.
 *
 * El ancho por carácter está calibrado midiendo etiquetas reales renderizadas:
 * "HTTPS" (5) ocupó 32 px y "Auto Scaling Group" (18) ocupó 116 px, o sea
 * 6.45 px por carácter a 10 px con letter-spacing 0.04em.
 */
const ANCHO_CARACTER = 6.45;
const LIMITE_ETIQUETA = Math.floor((SEP_H - 8) / ANCHO_CARACTER);
for (const flujo of flujos) {
  if (flujo.etiqueta && flujo.etiqueta.length > LIMITE_ETIQUETA) {
    console.warn(
      `[DiagramaAWS] "${titulo}": la etiqueta "${flujo.etiqueta}" tiene ` +
        `${flujo.etiqueta.length} caracteres y el máximo que cabe entre columnas ` +
        `es ${LIMITE_ETIQUETA}. Va a pisar las cajas vecinas; acórtala y mueve el ` +
        `detalle a la descripción.`
    );
  }
}

const columnas = calcularColumnas();
const totalColumnas = Math.max(...columnas.values()) + 1;

// Agrupa por columna para repartir las filas.
const porColumna = new Map<number, NodoDiagrama[]>();
for (const nodo of nodos) {
  const c = columnas.get(nodo.id) ?? 0;
  porColumna.set(c, [...(porColumna.get(c) ?? []), nodo]);
}
for (const [c, lista] of porColumna) {
  porColumna.set(
    c,
    [...lista].sort((a, b) => (a.fila ?? 0) - (b.fila ?? 0))
  );
}

const filasMax = Math.max(...[...porColumna.values()].map((l) => l.length));
const ancho = MARGEN * 2 + totalColumnas * NODO_W + (totalColumnas - 1) * SEP_H;
const alto = MARGEN * 2 + ALTO_ETIQUETA + filasMax * NODO_H + (filasMax - 1) * SEP_V;

/** Posición de cada nodo, centrando verticalmente cada columna. */
const cajas = new Map<string, { x: number; y: number }>();
for (const [c, lista] of porColumna) {
  const altoColumna = lista.length * NODO_H + (lista.length - 1) * SEP_V;
  const inicioY = ALTO_ETIQUETA + MARGEN + (alto - MARGEN * 2 - ALTO_ETIQUETA - altoColumna) / 2;
  lista.forEach((nodo, i) => {
    cajas.set(nodo.id, {
      x: MARGEN + c * (NODO_W + SEP_H),
      y: inicioY + i * (NODO_H + SEP_V),
    });
  });
}

const colorDe = (nodo: NodoDiagrama) =>
  nodo.tipo === 'externo' ? '#7d8798' : colorDeCategoria(nodo.categoria ?? '');

/** Identificadores únicos: puede haber varios diagramas en una misma página. */
const uid = Math.random().toString(36).slice(2, 8);

/**
 * Ancho mínimo antes de desplazar. En vez de fijar un número, se deriva de un
 * suelo de legibilidad: las etiquetas van a 14 px en el viewBox y no deben
 * quedar por debajo de 11 px al escalar. Así el diagrama se encoge lo justo
 * para caber en la columna de una ficha (max-w-3xl) sin scroll, y solo desplaza
 * en pantallas donde encogerlo más lo volvería ilegible.
 */
const MIN_FUENTE = 11;
const FUENTE_ETIQUETA = 14;
const anchoMinimo = Math.round(ancho * (MIN_FUENTE / FUENTE_ETIQUETA));

// Trazado de cada flecha, del borde derecho del origen al izquierdo del destino.
const flechas = flujos
  .map((flujo) => {
    const a = cajas.get(flujo.de);
    const b = cajas.get(flujo.a);
    if (!a || !b) return null;
    const x1 = a.x + NODO_W;
    const y1 = a.y + NODO_H / 2;
    const x2 = b.x;
    const y2 = b.y + NODO_H / 2;
    // Misma fila: recta. Distinta fila: curva suave para no cruzar cajas.
    const d =
      y1 === y2
        ? `M ${x1} ${y1} L ${x2 - 8} ${y2}`
        : `M ${x1} ${y1} C ${x1 + (x2 - x1) / 2} ${y1}, ${x1 + (x2 - x1) / 2} ${y2}, ${x2 - 8} ${y2}`;
    // La etiqueta va sobre el punto medio real del trazo. Usar el extremo más
    // alto colocaría la de una curva pegada a la caja de origen.
    return { d, etiqueta: flujo.etiqueta, mx: (x1 + x2) / 2, my: (y1 + y2) / 2 - 8 };
  })
  .filter((f): f is NonNullable<typeof f> => f !== null);
---

<figure class="my-8 not-prose">
  <!-- tabindex="0" porque una región con scroll debe poder recorrerse solo con
       el teclado; sin él, quien no usa ratón no llega al resto del diagrama. -->
  <div
    class="overflow-x-auto rounded-xl border border-tinta-200 bg-tinta-50 p-4"
    tabindex="0"
    role="group"
    aria-label={`Diagrama: ${titulo}`}
  >
    <svg
      role="img"
      aria-describedby={`pie-${uid}`}
      viewBox={`0 0 ${ancho} ${alto}`}
      style={`min-width:${anchoMinimo}px; max-width:${ancho}px; width:100%; height:auto;`}
    >
      <title>{titulo}</title>

      <defs>
        <marker
          id={`punta-${uid}`}
          viewBox="0 0 8 8"
          refX="7"
          refY="4"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M 0 0 L 8 4 L 0 8 z" fill="#7d8798" />
        </marker>
      </defs>

      <!-- Las etiquetas de flujo llevan un halo del color del fondo
           (paint-order="stroke") para que la flecha no las cruce por debajo. -->
      {flechas.map((flecha) => (
        <>
          <path
            d={flecha.d}
            fill="none"
            stroke="#7d8798"
            stroke-width="1.5"
            marker-end={`url(#punta-${uid})`}
          />
          {flecha.etiqueta && (
            <text
              x={flecha.mx}
              y={flecha.my}
              text-anchor="middle"
              class="font-mono"
              font-size="10"
              fill="#556072"
              letter-spacing="0.04em"
              paint-order="stroke"
              stroke="#f6f7f9"
              stroke-width="3"
              stroke-linejoin="round"
            >
              {flecha.etiqueta}
            </text>
          )}
        </>
      ))}

      {nodos.map((nodo) => {
        const caja = cajas.get(nodo.id)!;
        const color = colorDe(nodo);
        const externo = nodo.tipo === 'externo';
        return (
          <g>
            <rect
              x={caja.x}
              y={caja.y}
              width={NODO_W}
              height={NODO_H}
              rx="10"
              fill="#ffffff"
              stroke={externo ? '#b4bcca' : color}
              stroke-width="1.5"
              stroke-dasharray={externo ? '5 4' : undefined}
              opacity={externo ? 1 : 0.95}
            />
            {!externo && (
              <path
                d={`M ${caja.x + 10} ${caja.y + 1} H ${caja.x + NODO_W - 10}`}
                stroke={color}
                stroke-width="3"
                stroke-linecap="round"
              />
            )}
            <text
              x={caja.x + NODO_W / 2}
              y={caja.y + (nodo.sub ? 34 : 45)}
              text-anchor="middle"
              class="font-display"
              font-size="14"
              font-weight="700"
              fill="#161d26"
            >
              {nodo.etiqueta}
            </text>
            {nodo.sub && (
              <text
                x={caja.x + NODO_W / 2}
                y={caja.y + 53}
                text-anchor="middle"
                font-size="11"
                fill="#556072"
              >
                {nodo.sub}
              </text>
            )}
          </g>
        );
      })}
    </svg>
  </div>

  <figcaption id={`pie-${uid}`} class="mt-3 text-sm leading-relaxed text-tinta-600">
    <span class="font-mono text-[11px] uppercase tracking-widest text-tinta-500">
      {titulo}
    </span>
    <span class="mt-1 block">{descripcion}</span>
  </figcaption>
</figure>
