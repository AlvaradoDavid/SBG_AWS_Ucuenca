---
import { club } from '../lib/categorias';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-tinta-200 bg-marca-grey text-tinta-300">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 sm:grid-cols-[2fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-3">
        <img src="/marca/program-icon-amber.svg" alt="" width="32" height="32" class="h-8 w-8" />
        <span class="font-display text-base font-bold text-white">{club.nombre}</span>
      </div>
      <p class="mt-4 max-w-sm text-sm text-tinta-400">
        Comunidad enfocada en cloud computing, innovación y tecnologías AWS. Parte del programa
        global de AWS Student Builder Groups.
      </p>
      <p class="mt-3 font-mono text-xs uppercase tracking-widest text-tinta-500">
        Desde diciembre de 2025 · Cuenca, Ecuador
      </p>
    </div>

    <div>
      <p class="font-mono text-xs uppercase tracking-widest text-tinta-400">Sitio</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/" class="transition underline decoration-transparent decoration-2 underline-offset-4 hover:text-tinta-50 hover:decoration-marca-amber">Inicio</a></li>
        <li><a href="/servicios/" class="transition underline decoration-transparent decoration-2 underline-offset-4 hover:text-tinta-50 hover:decoration-marca-amber">Servicios AWS</a></li>
        <li><a href="/eventos/" class="transition underline decoration-transparent decoration-2 underline-offset-4 hover:text-tinta-50 hover:decoration-marca-amber">Eventos</a></li>
        <li><a href="/#nosotros" class="transition underline decoration-transparent decoration-2 underline-offset-4 hover:text-tinta-50 hover:decoration-marca-amber">Quiénes somos</a></li>
        <li><a href="/#trayectoria" class="transition underline decoration-transparent decoration-2 underline-offset-4 hover:text-tinta-50 hover:decoration-marca-amber">Trayectoria</a></li>
      </ul>
    </div>

    <div>
      <p class="font-mono text-xs uppercase tracking-widest text-tinta-400">Síguenos</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li>
          <a
            href={club.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 transition underline decoration-transparent decoration-2 underline-offset-4 hover:text-tinta-50 hover:decoration-marca-amber"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/>
            </svg>
            LinkedIn
          </a>
        </li>
        <li>
          <a
            href={club.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 transition underline decoration-transparent decoration-2 underline-offset-4 hover:text-tinta-50 hover:decoration-marca-amber"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.13 1.38C1.35 2.68.93 3.35.63 4.14.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.13.67.66 1.34 1.08 2.13 1.38.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56.79-.3 1.46-.72 2.13-1.38.66-.67 1.08-1.34 1.38-2.13.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91-.3-.79-.72-1.46-1.38-2.13C21.32 1.35 20.65.93 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm7.85-10.4a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0z"/>
            </svg>
            Instagram
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-tinta-800">
    <div class="mx-auto flex max-w-6xl flex-col gap-1 px-6 py-6 text-xs text-tinta-500 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {club.nombre} · {club.universidad}</p>
      <p>Construido con Astro y desplegado en AWS Amplify</p>
    </div>
  </div>
</footer>
