---
/**
 * El próximo evento que organiza el club, en la portada: va justo debajo del hero
 * y antes de los pilares mientras no haya terminado (D-31). Es el mismo cartel a
 * todo el ancho que encabeza la página del evento y, debajo, los patrocinadores.
 * Sin JavaScript.
 */
import CartelEvento from './CartelEvento.astro';
import Patrocinadores from './Patrocinadores.astro';
import type { Proximo } from '../lib/proximos';

interface Props {
  evento: Proximo;
}

const { evento } = Astro.props;
const { patrocinadores } = evento.data;
---

<section aria-labelledby="proximo-evento">
  <CartelEvento evento={evento} nivel="h2" idTitulo="proximo-evento" conDetalles />

  <!-- Los logos van solos, sin título: el club lo pidió así. La lista lleva su
       nombre para los lectores de pantalla. -->
  {patrocinadores.length > 0 && (
    <div class="mx-auto max-w-6xl px-6 pt-8">
      <Patrocinadores patrocinadores={patrocinadores} compacto />
    </div>
  )}
</section>
