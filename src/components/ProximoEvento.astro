---
/**
 * El próximo evento que organiza el club, en la portada: va justo debajo del hero
 * y antes de los pilares mientras no haya terminado (D-31). Es un cartel con la
 * composición del afiche —texto a la izquierda, la foto a la derecha— y, debajo,
 * los patrocinadores. Sin JavaScript.
 */
import { Image } from 'astro:assets';
import CartelEvento from './CartelEvento.astro';
import Patrocinadores from './Patrocinadores.astro';
import type { Proximo } from '../lib/proximos';

interface Props {
  evento: Proximo;
}

const { evento } = Astro.props;
const { imagen, patrocinadores } = evento.data;
---

<!-- En móvil el cartel gana un poco de ancho (px-4): así «Community Day» cabe en una línea. -->
<section aria-labelledby="proximo-evento" class="mx-auto max-w-6xl px-4 pt-12 sm:px-6 sm:pt-16">
  <div class="relative isolate overflow-hidden rounded-3xl bg-afiche shadow-2xl shadow-morado-950/20 lg:grid lg:grid-cols-[1.12fr_1fr]">
    <!-- El píxel de la esquina del afiche. -->
    <span aria-hidden="true" class="absolute left-0 top-0 z-10 h-9 w-9 bg-marca-magenta sm:h-11 sm:w-11"></span>

    <div class="relative z-10 px-5 pb-10 pt-16 sm:px-12 sm:pb-12 lg:py-14 lg:pl-16 lg:pr-4">
      <CartelEvento evento={evento} nivel="h2" idTitulo="proximo-evento" conDetalles />
    </div>

    <!-- La foto se funde con el fondo del cartel: arriba en móvil, a la izquierda
         en escritorio. Es decorativa; todo lo que dice el afiche está en el texto. -->
    <div class="relative h-64 sm:h-80 lg:h-auto">
      <Image
        src={imagen}
        alt=""
        widths={[480, 720]}
        sizes="(min-width: 1024px) 34rem, 100vw"
        class="absolute inset-0 h-full w-full object-cover object-[50%_45%] [mask-image:linear-gradient(to_bottom,transparent,#000_30%)] lg:[mask-image:linear-gradient(to_right,transparent,#000_22%)]"
      />
    </div>
  </div>

  <!-- Los logos van solos, sin título: el club lo pidió así. La lista lleva su
       nombre para los lectores de pantalla. -->
  {patrocinadores.length > 0 && (
    <div class="mt-6">
      <Patrocinadores patrocinadores={patrocinadores} compacto />
    </div>
  )}
</section>
