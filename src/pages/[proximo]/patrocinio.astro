---
/**
 * La página para empresas de un próximo evento: /student-community-day/patrocinio/
 * (D-32). Va de «usted», como el brochure, y todo lleva al mismo lugar: un chat de
 * WhatsApp con el mensaje ya escrito, que dice de dónde viene y qué nivel interesa.
 * Sin formularios y sin JavaScript: WhatsApp, Instagram, el teléfono y el correo
 * son enlaces, y la CSP no limita la navegación.
 *
 * Se genera solo para los eventos con `patrocinio`. Después del evento sigue en su
 * URL, sin niveles ni botón fijo, con el contacto para la próxima edición.
 */
import Layout from '../../layouts/Layout.astro';
import Patrocinadores from '../../components/Patrocinadores.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { diaDeEvento, horaDeEvento } from '../../lib/fechas';
import { estaVigente, type Proximo } from '../../lib/proximos';
import {
  enlaceCorreo,
  enlaceWhatsApp,
  instagramDirecto,
  mensajeDePatrocinio,
  novedadesDeNivel,
  precioDeNivel,
  telefonoLegible,
  usuarioInstagram,
  type Patrocinio,
} from '../../lib/patrocinio';

export async function getStaticPaths() {
  const proximos = await getCollection('proximos');
  return proximos
    .filter((evento) => evento.data.patrocinio)
    .map((evento) => ({ params: { proximo: evento.id }, props: { evento } }));
}

const { evento } = Astro.props as { evento: Proximo };
const { titulo, nombreCorto, inicio, fin, lugar, afiche, participantes, patrocinadores } = evento.data;
const patrocinio = evento.data.patrocinio as Patrocinio;
const { titular, presentacion, foto, fotoAlt, cifras, publico, razones, contacto, aviso, niveles, beneficios } =
  patrocinio;

const vigente = estaVigente(evento);
const ciudades = new Set(participantes.map((p) => p.ciudad)).size;
const todasLasCifras = [
  ...cifras,
  { valor: String(participantes.length), etiqueta: `Student Builder Groups de ${ciudades} ciudades` },
];

const whatsapp = enlaceWhatsApp(contacto.whatsapp, mensajeDePatrocinio(evento));
const telefono = telefonoLegible(contacto.whatsapp);
const masBarato = niveles.reduce((a, b) => (b.precio < a.precio ? b : a));
const empresas = new Intl.ListFormat('es', { type: 'conjunction' }).format(patrocinadores.map((p) => p.nombre));

/** Los íconos del kit, en el orden de las razones: morado, celeste y amber, como los pilares. */
const iconosDeRazones = [
  { src: '/marca/icono-speaker-purple.svg', color: 'var(--color-marca-purple)' },
  { src: '/marca/icono-ladder-blue.svg', color: 'var(--color-marca-blue)' },
  { src: '/marca/icono-teams-amber.svg', color: 'var(--color-marca-amber)' },
];

const icono = {
  whatsapp: {
    relleno: true,
    d: 'M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.47-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.91-2.2-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.27-.2-.57-.35m-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89a11.82 11.82 0 0 0-3.48-8.41Z',
  },
  telefono: {
    relleno: false,
    d: 'M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z',
  },
  instagram: {
    relleno: true,
    d: 'M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.13 1.38C1.35 2.68.93 3.35.63 4.14.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.13.67.66 1.34 1.08 2.13 1.38.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56.79-.3 1.46-.72 2.13-1.38.66-.67 1.08-1.34 1.38-2.13.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91-.3-.79-.72-1.46-1.38-2.13C21.32 1.35 20.65.93 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm7.85-10.4a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0z',
  },
  correo: {
    relleno: false,
    d: 'M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75',
  },
};

/**
 * El orden es el de preferencia: WhatsApp primero y destacado. Al mostrarlos, el
 * correo puede partirse después de la @, nunca a mitad de palabra.
 */
const canales = [
  { nombre: 'WhatsApp', valor: telefono, accion: 'Abrir el chat con el mensaje listo', href: whatsapp, icono: icono.whatsapp, externo: true },
  { nombre: 'Teléfono', valor: telefono, accion: 'Llamar ahora', href: `tel:${contacto.whatsapp}`, icono: icono.telefono, externo: false },
  { nombre: 'Instagram', valor: `@${usuarioInstagram}`, accion: 'Enviar un mensaje directo', href: instagramDirecto, icono: icono.instagram, externo: true },
  {
    nombre: 'Correo',
    valor: contacto.correo,
    accion: 'Escribir un correo',
    href: enlaceCorreo(contacto.correo, `Patrocinio · ${titulo}`, mensajeDePatrocinio(evento)),
    icono: icono.correo,
    externo: false,
  },
];

const check = 'm4.5 12.75 6 6 9-13.5';

/**
 * El botón de cada nivel dice solo «Me interesa», para caber en una línea con cuatro
 * columnas; el nombre del nivel va en texto para lectores de pantalla.
 */
const boton =
  'inline-flex items-center justify-center gap-2 rounded-lg px-5 py-3 text-sm font-bold transition';
---

<Layout
  title={`Patrocinio · ${titulo}`}
  description={`${titular}. ${niveles.length} niveles de patrocinio desde ${precioDeNivel(masBarato)} para el ${titulo}, ${diaDeEvento(inicio, { conAnio: true })} en ${lugar.at(-1)}.`}
  imagen={afiche}
  imagenAlt={`Afiche del ${titulo}: ${diaDeEvento(inicio)}, ${lugar.join(', ')}`}
>
  <div data-pagefind-body>
    <!-- Cabecera: la misma familia que el cartel del evento, con la foto del club a la derecha. -->
    <header class="relative isolate overflow-hidden bg-afiche">
      <span aria-hidden="true" class="absolute left-0 top-0 z-10 h-10 w-10 bg-marca-magenta sm:h-12 sm:w-12"></span>

      <div class="mx-auto max-w-6xl px-6 lg:grid lg:grid-cols-2">
        <div class="relative z-10 pb-12 pt-16 sm:pb-14 sm:pt-20 lg:py-20 lg:pr-6">
          <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 font-mono text-[11px] uppercase tracking-widest text-tinta-100 ring-1 ring-white/15">
            <span aria-hidden="true" class="h-2 w-2 shrink-0 bg-marca-magenta"></span>
            Patrocinio · {nombreCorto}
          </p>
          <h1 class="mt-5 font-display text-[clamp(2rem,7vw,3rem)] font-bold leading-[1.05] tracking-tight text-white">
            {titular}
          </h1>
          <p class="mt-5 max-w-xl leading-relaxed text-tinta-200 sm:text-lg">{presentacion}</p>

          <ul class="mt-6 space-y-2 text-sm text-tinta-200">
            <li class="flex items-start gap-2.5">
              <svg aria-hidden="true" class="mt-px h-5 w-5 shrink-0 text-marca-purple" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
              </svg>
              <span>
                <span class="sr-only">Fecha: </span>
                <span class="inline-block font-bold text-white first-letter:uppercase">{diaDeEvento(inicio, { conAnio: true })}</span>,
                de {horaDeEvento(inicio)} a {horaDeEvento(fin)}
              </span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg aria-hidden="true" class="mt-px h-5 w-5 shrink-0 text-marca-purple" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
              </svg>
              <span><span class="sr-only">Lugar: </span>{lugar.join(', ')}</span>
            </li>
          </ul>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[boton, 'bg-white px-6 text-tinta-900 hover:bg-morado-50 hover:shadow-[0_0_28px_-4px_var(--color-marca-purple)]']}
            >
              <svg aria-hidden="true" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d={icono.whatsapp.d} /></svg>
              Escribir por WhatsApp
            </a>
            {vigente && (
              <a href="#niveles" class:list={[boton, 'border border-white/30 bg-white/5 px-6 text-white hover:border-white/60 hover:bg-white/10']}>
                Ver niveles y precios
              </a>
            )}
          </div>

          <dl class="mt-10 grid gap-4 border-t border-white/15 pt-6 sm:grid-cols-3 sm:gap-6">
            {todasLasCifras.map(({ valor, etiqueta }) => (
              <div class="flex flex-row-reverse items-baseline justify-end gap-3 sm:flex-col-reverse sm:gap-1">
                <dt class="text-sm leading-snug text-tinta-300">{etiqueta}</dt>
                <dd class="font-display text-2xl font-bold tabular-nums text-white sm:text-3xl">{valor}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <!-- La foto es panorámica: se pide al ancho que ocupa al cubrir el recuadro, no al del recuadro. -->
      <div class="relative h-64 sm:h-80 lg:absolute lg:inset-y-0 lg:right-0 lg:h-auto lg:w-[46%]">
        <Image
          src={foto}
          alt={fotoAlt}
          widths={[720, 1200, 1600]}
          sizes="(min-width: 1024px) 1400px, 720px"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover object-[50%_40%] [mask-image:linear-gradient(to_bottom,transparent,#000_30%)] lg:[mask-image:linear-gradient(to_right,transparent,#000_22%)]"
        />
      </div>
    </header>

    <!-- Prueba social: las empresas que ya apoyan el evento, antes de pedir nada. -->
    {patrocinadores.length > 0 && (
      <section class="mx-auto max-w-6xl px-6 py-14 text-center sm:py-16">
        <p class="font-mono text-xs uppercase tracking-widest text-tinta-500">Ya nos acompañan</p>
        <h2 class="mt-3 font-display text-2xl font-bold text-tinta-900 sm:text-3xl">
          {vigente ? 'Empresas que ya confían en el evento' : 'Empresas que hicieron posible el evento'}
        </h2>
        <div data-reveal class="mt-8">
          <Patrocinadores patrocinadores={patrocinadores} />
        </div>
        <p class="mx-auto mt-6 max-w-2xl text-sm leading-relaxed text-tinta-600">
          {empresas}
          {vigente
            ? (patrocinadores.length === 1 ? ' ya apoya' : ' ya apoyan')
            : (patrocinadores.length === 1 ? ' apoyó' : ' apoyaron')}
          {' '}el {titulo}.
        </p>
      </section>
    )}

    <!-- Por qué patrocinar -->
    <section class="fondo-aurora border-y border-morado-100">
      <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
        <p class="font-mono text-xs uppercase tracking-widest text-tinta-500">Por qué patrocinar</p>
        <h2 class="mt-3 max-w-2xl font-display text-3xl font-bold text-tinta-900">
          Un catalizador para su marca empleadora y comercial
        </h2>

        <h3 class="mt-8 text-sm font-bold text-tinta-700">Su marca, frente a:</h3>
        <ul class="mt-3 flex flex-wrap gap-2">
          {publico.map((perfil) => (
            <li class="rounded-full bg-white px-4 py-2 text-sm font-bold text-tinta-700 ring-1 ring-morado-200">{perfil}</li>
          ))}
        </ul>

        <ul class="mt-10 grid gap-6 md:grid-cols-3">
          {razones.map((razon, i) => (
            <li
              data-reveal
              style={`--color-razon: ${iconosDeRazones[i].color}`}
              class="relative overflow-hidden rounded-2xl border border-morado-100 bg-white p-6 shadow-sm shadow-morado-900/5"
            >
              <span
                aria-hidden="true"
                class="pointer-events-none absolute -right-20 -top-20 h-48 w-48 rounded-full bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--color-razon)_20%,transparent),transparent)]"
              ></span>
              <span class="relative flex h-14 w-14 items-center justify-center rounded-xl bg-[color-mix(in_srgb,var(--color-razon)_12%,white)] ring-1 ring-[color-mix(in_srgb,var(--color-razon)_30%,transparent)]">
                <img src={iconosDeRazones[i].src} alt="" width="32" height="32" class="h-8 w-8" />
              </span>
              <h3 class="relative mt-5 font-display text-lg font-bold text-tinta-900">{razon.titulo}</h3>
              <p class="relative mt-2 text-sm leading-relaxed text-tinta-600">{razon.texto}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Niveles: cada tarjeta con su propio botón, que dice en el mensaje qué nivel interesa. -->
    {vigente && (
      <section id="niveles" class="mx-auto max-w-6xl px-6 pb-24 pt-16 sm:py-20">
        <p class="font-mono text-xs uppercase tracking-widest text-tinta-500">Niveles de patrocinio</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-tinta-900">Elija cómo quiere estar presente</h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-tinta-600">
          Cada nivel suma beneficios al anterior. El botón de cada uno abre WhatsApp con el mensaje
          listo: solo falta el nombre de su empresa. Precios en dólares de los Estados Unidos.
        </p>

        <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {niveles.map((nivel, i) => {
            // El último es el más completo: va en el azul del cartel para que se distinga.
            const oscuro = i === niveles.length - 1;
            return (
              <li
                data-reveal
                class:list={[
                  'flex flex-col rounded-2xl p-6',
                  oscuro
                    ? 'bg-afiche text-tinta-200 shadow-xl shadow-morado-950/20 ring-1 ring-white/10'
                    : 'border border-morado-100 bg-white text-tinta-600 shadow-sm shadow-morado-900/5',
                ]}
              >
                <h3 class:list={['font-mono text-xs uppercase tracking-widest', oscuro ? 'text-tinta-200' : 'text-tinta-500']}>
                  {nivel.nombre}
                </h3>
                <p class="mt-3 flex items-baseline gap-1.5">
                  <span class:list={['font-display text-4xl font-bold tabular-nums', oscuro ? 'text-white' : 'text-tinta-900']}>
                    {precioDeNivel(nivel)}
                  </span>
                  <span class="text-sm">USD</span>
                </p>
                {(nivel.agotado || aviso) && (
                  <p
                    class:list={[
                      'mt-4 inline-flex items-center gap-2 self-start rounded-full px-3 py-1 text-xs font-bold',
                      oscuro ? 'bg-white/10 text-tinta-100 ring-1 ring-white/15' : 'bg-morado-100 text-tinta-700 ring-1 ring-morado-200',
                    ]}
                  >
                    <span aria-hidden="true" class="h-1.5 w-1.5 bg-marca-magenta"></span>
                    {nivel.agotado ? 'Agotado' : aviso}
                  </p>
                )}
                <p class:list={['mt-6 text-sm font-bold', oscuro ? 'text-white' : 'text-tinta-900']}>
                  {i === 0 ? 'Incluye:' : `Todo lo de ${niveles[i - 1].nombre}, más:`}
                </p>
                <ul class="mt-3 flex-1 space-y-2.5 text-sm leading-snug">
                  {novedadesDeNivel(patrocinio, i).map((novedad) => (
                    <li class="flex gap-2.5">
                      <svg aria-hidden="true" class="mt-px h-4 w-4 shrink-0 text-marca-purple" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d={check} />
                      </svg>
                      {novedad}
                    </li>
                  ))}
                </ul>
                {nivel.agotado ? (
                  <p class="mt-6 text-sm">Escríbanos y le contamos qué otro nivel le conviene.</p>
                ) : (
                  <a
                    href={enlaceWhatsApp(contacto.whatsapp, mensajeDePatrocinio(evento, nivel))}
                    target="_blank"
                    rel="noopener noreferrer"
                    class:list={[
                      boton,
                      'mt-6',
                      oscuro
                        ? 'bg-white text-tinta-900 hover:bg-morado-50 hover:shadow-[0_0_28px_-4px_var(--color-marca-purple)]'
                        : 'bg-morado-700 text-white hover:bg-morado-800',
                    ]}
                  >
                    <svg aria-hidden="true" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d={icono.whatsapp.d} /></svg>
                    Me interesa<span class="sr-only"> el nivel {nivel.nombre}</span>
                  </a>
                )}
              </li>
            );
          })}
        </ol>

        <!-- La comparativa completa, plegada: en el celular la tabla se desplaza de lado
             con la columna de beneficios fija. El contenedor va con `relative` para que
             los «Incluido» de sr-only, que son absolutos, no se salgan de él y ensanchen
             la página. -->
        <details class="group mt-10 rounded-2xl border border-tinta-200 bg-white">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-2xl px-6 py-4 font-bold text-tinta-900 transition hover:bg-morado-50 [&::-webkit-details-marker]:hidden">
            Ver la comparativa completa
            <svg aria-hidden="true" class="h-5 w-5 shrink-0 text-tinta-500 transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </summary>
          <div role="region" aria-labelledby="comparativa" tabindex="0" class="relative overflow-x-auto border-t border-tinta-200">
            <table class="w-full min-w-[36rem] border-collapse text-left text-sm">
              <caption id="comparativa" class="sr-only">Comparativa de beneficios por nivel de patrocinio</caption>
              <thead>
                <tr>
                  <th scope="col" class="sticky left-0 z-10 w-44 bg-white px-4 py-4 font-mono text-[11px] font-bold uppercase tracking-widest text-tinta-500 sm:w-auto sm:px-6">
                    Beneficio
                  </th>
                  {niveles.map((nivel) => (
                    <th scope="col" class="px-3 py-4 text-center">
                      <span class="block font-mono text-[11px] uppercase tracking-widest text-tinta-500">{nivel.nombre}</span>
                      <span class="mt-1 block font-display text-base font-bold text-tinta-900">{precioDeNivel(nivel)}</span>
                    </th>
                  ))}
                </tr>
              </thead>
              {beneficios.map((grupo) => (
                <tbody>
                  <tr>
                    <th
                      scope="rowgroup"
                      colspan={niveles.length + 1}
                      class="bg-morado-50 py-2.5 font-mono text-[11px] font-bold uppercase tracking-widest text-tinta-600"
                    >
                      <span class="sticky left-0 inline-block px-4 sm:px-6">{grupo.grupo}</span>
                    </th>
                  </tr>
                  {grupo.filas.map((fila) => (
                    <tr class="border-t border-tinta-100">
                      <th scope="row" class="sticky left-0 z-10 w-44 bg-white px-4 py-3 font-normal leading-snug text-tinta-700 sm:w-auto sm:px-6">
                        {fila.beneficio}
                      </th>
                      {fila.valores.map((valor) => (
                        <td class="px-3 py-3 text-center leading-snug text-tinta-900">
                          {valor === true ? (
                            <>
                              <svg aria-hidden="true" class="mx-auto h-5 w-5 text-morado-700" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d={check} />
                              </svg>
                              <span class="sr-only">Incluido</span>
                            </>
                          ) : valor === false ? (
                            <>
                              <span aria-hidden="true" class="text-tinta-300">—</span>
                              <span class="sr-only">No incluido</span>
                            </>
                          ) : (
                            valor
                          )}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              ))}
            </table>
          </div>
        </details>
      </section>
    )}

    <!-- En el celular, WhatsApp siempre a mano hasta llegar al contacto. Sin JavaScript:
         una caja de alto cero, pegada al borde inferior, con la barra colgando hacia
         arriba; al llegar a su lugar, antes del contacto, se va con la página. -->
    {vigente && (
      <div data-pagefind-ignore class="sticky bottom-0 z-40 h-0 md:hidden">
        <div class="absolute inset-x-0 bottom-0 border-t border-tinta-200 bg-white/95 px-6 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3 backdrop-blur">
          <a href={whatsapp} target="_blank" rel="noopener noreferrer" class:list={[boton, 'w-full bg-morado-700 text-white hover:bg-morado-800']}>
            <svg aria-hidden="true" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d={icono.whatsapp.d} /></svg>
            Escribir por WhatsApp
          </a>
        </div>
      </div>
    )}

    <!-- Contacto: el cierre, en el azul del cartel como la cabecera. -->
    <section id="contacto" class="relative isolate overflow-hidden bg-afiche">
      <span aria-hidden="true" class="absolute right-0 top-0 h-10 w-10 bg-marca-magenta sm:h-12 sm:w-12"></span>
      <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
        <p class="font-mono text-xs uppercase tracking-widest text-tinta-300">Contacto</p>
        <h2 class="mt-3 max-w-3xl font-display text-3xl font-bold text-white sm:text-4xl">
          {vigente
            ? 'Asegure el lugar de su empresa en el futuro del cómputo cloud y la IA'
            : '¿Quiere estar en la próxima edición?'}
        </h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-tinta-200">
          Agende una reunión con el equipo organizador: le respondemos por el canal que prefiera.
        </p>

        <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {canales.map((canal, i) => {
            const principal = i === 0;
            return (
              <li>
                <a
                  href={canal.href}
                  target={canal.externo ? '_blank' : undefined}
                  rel={canal.externo ? 'noopener noreferrer' : undefined}
                  class:list={[
                    'flex h-full flex-col rounded-2xl p-5 transition',
                    principal
                      ? 'bg-white text-tinta-900 hover:shadow-[0_0_28px_-4px_var(--color-marca-purple)]'
                      : 'bg-white/5 text-white ring-1 ring-white/15 hover:bg-white/10 hover:ring-white/30',
                  ]}
                >
                  <span class:list={['flex items-center gap-2 font-mono text-[11px] uppercase tracking-widest', principal ? 'text-tinta-500' : 'text-tinta-300']}>
                    <svg
                      aria-hidden="true"
                      class="h-5 w-5 shrink-0 text-marca-purple"
                      viewBox="0 0 24 24"
                      fill={canal.icono.relleno ? 'currentColor' : 'none'}
                      stroke={canal.icono.relleno ? undefined : 'currentColor'}
                      stroke-width={canal.icono.relleno ? undefined : 1.8}
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d={canal.icono.d} />
                    </svg>
                    {canal.nombre}
                  </span>
                  <span class="mt-3 font-display text-base font-bold [overflow-wrap:anywhere] sm:text-lg">
                    {canal.valor.split(/(?<=.@)/).map((parte, j) => (
                      <>{j > 0 && <wbr />}{parte}</>
                    ))}
                  </span>
                  <span class:list={['mt-1 text-sm', principal ? 'text-tinta-600' : 'text-tinta-300']}>{canal.accion}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  </div>
</Layout>
