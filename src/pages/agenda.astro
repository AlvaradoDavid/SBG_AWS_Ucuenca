---
/**
 * /agenda/: la URL corta para compartir la agenda del evento (D-34). Lleva a
 * /<evento>/#agenda con un meta refresh, que funciona también sin JavaScript, y
 * trae el afiche como og:image, para que la vista previa en WhatsApp o Instagram
 * no salga vacía: eso es lo que descarta la redirección de Amplify o la de Astro (D-31).
 *
 * Lleva a la agenda del próximo evento que la tenga; cuando ya pasaron todos, a la
 * del último. La canónica es la página del evento, no esta.
 */
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { diaDeEvento } from '../lib/fechas';
import { estaVigente, rutaDeProximo, tieneAgenda } from '../lib/proximos';

const conAgenda = (await getCollection('proximos'))
  .filter(tieneAgenda)
  .sort((a, b) => a.data.inicio.getTime() - b.data.inicio.getTime());
const evento = conAgenda.find((e) => estaVigente(e)) ?? conAgenda.at(-1);

const destino = evento ? `${rutaDeProximo(evento)}#agenda` : '/';
const canonica = new URL(evento ? rutaDeProximo(evento) : '/', Astro.site).href;
const titulo = evento ? `Agenda del ${evento.data.titulo}` : 'Agenda';
const descripcion = evento
  ? `Horarios, salas y ponentes del ${evento.data.titulo}: ${diaDeEvento(evento.data.inicio)}, en el ${evento.data.lugar[0]}.`
  : undefined;
---

<Layout
  title={titulo}
  description={descripcion}
  imagen={evento?.data.afiche}
  imagenAlt={evento && `Afiche del ${evento.data.titulo}`}
  canonica={false}
>
  <Fragment slot="head">
    <meta http-equiv="refresh" content={`0; url=${destino}`} />
    <link rel="canonical" href={canonica} />
  </Fragment>

  <section class="fondo-aurora-superior">
    <div class="mx-auto max-w-3xl px-6 py-24 text-center sm:py-32">
      <p class="font-mono text-xs uppercase tracking-widest text-tinta-500">Agenda</p>
      <h1 class="mt-3 font-display text-3xl font-bold text-tinta-900 sm:text-4xl">{titulo}</h1>
      <p class="mt-4 leading-relaxed text-tinta-600">Te llevamos a la agenda. Si no se abre sola, usa el botón.</p>
      <a
        href={destino}
        class="mt-8 inline-flex items-center justify-center gap-2 rounded-lg bg-morado-700 px-5 py-3 text-sm font-bold text-white transition hover:bg-morado-800"
      >
        Ver la agenda
      </a>
    </div>
  </section>
</Layout>
