---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { fotosDeEvento, portadaDeEvento } from '../../lib/fotos';
import { fechaLarga } from '../../lib/fechas';

/** En orden cronológico, del más antiguo al más reciente, como la trayectoria de la portada (D-29). */
const eventos = (await getCollection('eventos')).sort(
  (a, b) => a.data.fecha.getTime() - b.data.fecha.getTime()
);

const conFotos = eventos.map((evento) => ({
  evento,
  fotos: fotosDeEvento(evento.data.carpetaFotos),
  portada: portadaDeEvento(evento.data.carpetaFotos, evento.data.portada),
}));

const totalFotos = conFotos.reduce((suma, e) => suma + e.fotos.length, 0);
---

<Layout
  title="Eventos"
  description="Stands, charlas y webinars del AWS Student Builder Group de la Universidad de Cuenca."
>
  <div class="fondo-aurora-superior">
    <section class="mx-auto max-w-6xl px-6 py-14">
      <p class="font-mono text-xs uppercase tracking-widest text-tinta-500">Eventos</p>
      <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-tinta-900">
        Lo que hemos hecho
      </h1>
      <p class="mt-4 max-w-2xl leading-relaxed text-tinta-600">
        {eventos.length} eventos realizados y {totalFotos} fotos que lo documentan. Stands, charlas
        y webinars donde el grupo lleva la nube a estudiantes y a la comunidad.
      </p>

      <div class="mt-12 space-y-6">
        {conFotos.map(({ evento, fotos, portada }) => (
          <a
            href={`/eventos/${evento.id}/`}
            data-reveal
            class="group grid gap-6 overflow-hidden rounded-xl border border-tinta-200 bg-white transition hover:border-morado-300 hover:shadow-lg hover:shadow-morado-700/10 sm:grid-cols-[320px_1fr]"
          >
            {portada ? (
              <Image
                src={portada.miniatura}
                alt={evento.data.titulo}
                widths={[320, 640]}
                sizes="(max-width: 640px) 100vw, 320px"
                class="h-56 w-full object-cover transition duration-300 group-hover:scale-105 sm:h-full"
              />
            ) : (
              <div class="h-56 w-full bg-tinta-100 sm:h-full"></div>
            )}
            <div class="p-6 sm:py-8 sm:pr-8">
              <p class="font-mono text-xs uppercase tracking-widest text-tinta-500">
                {fechaLarga(evento.data.fecha)}
                {evento.data.lugar && <span> · {evento.data.lugar}</span>}
              </p>
              <h2 class="mt-3 font-display text-2xl font-bold text-tinta-900">
                {evento.data.titulo}
              </h2>
              <p class="mt-3 leading-relaxed text-tinta-600">{evento.data.resumen}</p>
              <p class="mt-4 text-sm font-bold text-tinta-900">
                {fotos.length === 1 ? 'Ver la foto →' : `Ver las ${fotos.length} fotos →`}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
